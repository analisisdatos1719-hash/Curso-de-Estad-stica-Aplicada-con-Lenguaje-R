# Gráficos

names(datos)

# Gráfico de barras con lineas de error (Media + DE)

library(dplyr)

resumen <- datos %>%
  group_by(Region) %>%
  summarise(
    media = mean(TCH, na.rm = TRUE),
    DE = sd(TCH, na.rm = TRUE),
    n = n(),
    SE = DE / sqrt(n)
  ) %>%
  mutate( IC_inf = media - 1.96 * SE,
          IC_sup = media + 1.96 * SE
  )

resumen

library(ggplot2)

ggplot(resumen, aes(x = Region, y = media)) +
  geom_col(fill = "skyblue") +
  geom_errorbar(aes(ymin = media - DE, ymax = media + DE), width = 0.2) +
  labs(title = "TCH por región (Media ± DE)",
       x = "Región", y = "TCH") +
  theme_minimal()

# Media + SE


ggplot(resumen, aes(x = Region, y = media)) +
  geom_col(fill = "lightgreen") +
  geom_errorbar(aes(ymin = media - SE, ymax = media + SE), width = 0.2) +
  labs(title = "TCH por región (Media ± SE)",
       x = "Región", y = "TCH") +
  theme_minimal()

# Media + IC

resumen <- resumen %>%
  mutate(
    IC_inf = media - 1.96 * SE,
    IC_sup = media + 1.96 * SE
  )

ggplot(resumen, aes(x = Region, y = media)) +
  geom_col(fill = "salmon") +
  geom_errorbar(aes(ymin = IC_inf, ymax = IC_sup), width = 0.2) +
  labs(title = "TCH por región (Media ± IC 95%)",
       x = "Región", y = "TCH") +
  theme_minimal()



