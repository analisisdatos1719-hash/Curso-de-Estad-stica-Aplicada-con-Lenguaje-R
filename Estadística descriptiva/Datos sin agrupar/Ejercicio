str(datos)


# Calcular estadísticas descriptivas por Tratamiento
resumen_trat <- datos %>% 
  group_by(Region) %>% 
  summarise(
    n = n(),
    media = round(mean(TCH, na.rm = TRUE), 2),
    mediana = round(median(TCH, na.rm = TRUE), 2),
    minimo = round(min(TCH, na.rm = TRUE), 2),
    maximo = round(max(TCH, na.rm = TRUE), 2),
    rango = round(maximo-minimo, 2),
    DE = round(sd(TCH, na.rm = TRUE), 2),
    varianza = round(var(TCH, na.rm = TRUE), 2),
    CV = round((sd(TCH, na.rm = TRUE) / 
                  mean(TCH, na.rm = TRUE)) * 100, 2),
    EE = round(sd(TCH, na.rm = TRUE) / sqrt(n()), 2),
    Q1 = round(quantile(TCH, 0.25, na.rm = TRUE), 2),
    Q2 = round(quantile(TCH, 0.50, na.rm = TRUE), 2),
    Q3 = round(quantile(TCH, 0.75, na.rm = TRUE), 2),
    asimetria = round(skewness(TCH, na.rm = TRUE), 2),
    curtosis = round(kurtosis(TCH, na.rm = TRUE), 2)
  )
resumen_trat
View(resumen_trat)

# Mostrar resultados
print(resumen_trat)

